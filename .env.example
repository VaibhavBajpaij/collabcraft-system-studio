# CollabCraft System Studio - Environment Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=CollabCraft System Studio
NEXT_PUBLIC_DEFAULT_ROOM=production-main-room

# Yjs WebSocket Relay Endpoint (defaults to ws://localhost:1234 in dev, wss://demos.yjs.dev/ws fallback)
NEXT_PUBLIC_WS_ENDPOINT=ws://localhost:1234
PORT=3000
WS_PORT=1234
COLLABCRAFT_URL=http://localhost:3000
