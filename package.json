{
  "name": "collabcraft-system-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Collaborative System Architecture Studio & Whiteboard powered by Next.js 15, TypeScript, Yjs CRDTs, WebSockets, and AI Architecture Copilot.",
  "bin": {
    "collabcraft-mcp": "./bin/collabcraft-mcp.js"
  },
  "scripts": {
    "dev": "next dev",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --target=node18 --outfile=dist/mcp.js",
    "build": "npm run build:mcp && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "server": "ts-node src/server/websocketServer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^13.0.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.1.7",
    "open": "^11.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
